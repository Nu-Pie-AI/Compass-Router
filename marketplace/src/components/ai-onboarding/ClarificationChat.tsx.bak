'use client';

import { useState } from 'react';
import { MessageCircle, Send, SkipForward } from 'lucide-react';

interface ClarificationQuestion {
  questionId: string;
  question: string;
  context: string;
}

interface ClarificationChatProps {
  questions: ClarificationQuestion[];
  onSubmit: (clarifications: Record<string, string>) => void;
  onSkip: () => void;
  confidenceScore?: number;
}

export function ClarificationChat({
  questions,
  onSubmit,
  onSkip,
  confidenceScore,
}: ClarificationChatProps) {
  const [currentQuestionIndex, setCurrentQuestionIndex] = useState(0);
  const [answers, setAnswers] = useState<Record<string, string>>({});
  const [currentAnswer, setCurrentAnswer] = useState('');

  const currentQuestion = questions[currentQuestionIndex];
  const progress = ((currentQuestionIndex + 1) / questions.length) * 100;
  const answeredCount = Object.keys(answers).length;

  const handleAnswerSubmit = (e: React.FormEvent) => {
    e.preventDefault();

    if (!currentAnswer.trim()) return;

    const newAnswers = {
      ...answers,
      [currentQuestion.questionId]: currentAnswer.trim(),
    };

    setAnswers(newAnswers);
    setCurrentAnswer('');

    // Move to next question or submit all
    if (currentQuestionIndex < questions.length - 1) {
      setCurrentQuestionIndex(currentQuestionIndex + 1);
    } else {
      // All questions answered
      onSubmit(newAnswers);
    }
  };

  const handleSkipQuestion = () => {
    if (currentQuestionIndex < questions.length - 1) {
      setCurrentQuestionIndex(currentQuestionIndex + 1);
    } else {
      // Submit partial answers or skip entirely
      if (Object.keys(answers).length > 0) {
        onSubmit(answers);
      } else {
        onSkip();
      }
    }
  };

  return (
    <div className="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700">
      {/* Header */}
      <div className="p-6 border-b border-gray-200 dark:border-gray-700">
        <div className="flex items-start justify-between mb-4">
          <div>
            <h2 className="text-xl font-semibold text-gray-900 dark:text-white mb-2">
              Help Us Complete Your Profile
            </h2>
            <p className="text-sm text-gray-600 dark:text-gray-400">
              Answer a few quick questions to improve your offering's quality
            </p>
          </div>
          {confidenceScore !== undefined && (
            <div className="flex flex-col items-end">
              <span className="text-xs text-gray-500 dark:text-gray-400 mb-1">
                Confidence
              </span>
              <div className="flex items-baseline gap-1">
                <span className="text-2xl font-bold text-purple-600 dark:text-purple-400">
                  {confidenceScore}%
                </span>
              </div>
            </div>
          )}
        </div>

        {/* Progress Bar */}
        <div className="space-y-2">
          <div className="flex items-center justify-between text-sm">
            <span className="text-gray-600 dark:text-gray-400">
              Question {currentQuestionIndex + 1} of {questions.length}
            </span>
            <span className="text-gray-500 dark:text-gray-500">
              {answeredCount} answered
            </span>
          </div>
          <div className="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
            <div
              className="h-full bg-purple-600 dark:bg-purple-500 rounded-full transition-all duration-300"
              style={{ width: `${progress}%` }}
            />
          </div>
        </div>
      </div>

      {/* Chat Area */}
      <div className="p-6 min-h-[300px] flex flex-col">
        {/* AI Message */}
        <div className="flex gap-3 mb-6">
          <div className="flex-shrink-0">
            <div className="w-8 h-8 bg-purple-100 dark:bg-purple-900/30 rounded-full flex items-center justify-center">
              <MessageCircle className="w-4 h-4 text-purple-600 dark:text-purple-400" />
            </div>
          </div>
          <div className="flex-1">
            <div className="bg-gray-100 dark:bg-gray-700 rounded-lg rounded-tl-none p-4">
              <p className="text-sm font-medium text-gray-900 dark:text-white mb-2">
                {currentQuestion.question}
              </p>
              <p className="text-xs text-gray-600 dark:text-gray-400">
                {currentQuestion.context}
              </p>
            </div>
          </div>
        </div>

        {/* User Answers (Previous) */}
        {currentQuestionIndex > 0 && answeredCount > 0 && (
          <div className="mb-4 flex justify-end">
            <div className="bg-purple-100 dark:bg-purple-900/30 rounded-lg rounded-tr-none p-3 max-w-md">
              <p className="text-sm text-gray-700 dark:text-gray-300">
                {answeredCount} question{answeredCount > 1 ? 's' : ''} answered ✓
              </p>
            </div>
          </div>
        )}

        {/* Input Form */}
        <form onSubmit={handleAnswerSubmit} className="mt-auto">
          <div className="flex gap-2">
            <textarea
              value={currentAnswer}
              onChange={(e) => setCurrentAnswer(e.target.value)}
              placeholder="Type your answer here..."
              rows={3}
              className="flex-1 px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-purple-500 dark:focus:ring-purple-400 focus:border-transparent bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 resize-none"
              onKeyDown={(e) => {
                if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                  handleAnswerSubmit(e);
                }
              }}
            />
            <div className="flex flex-col gap-2">
              <button
                type="submit"
                disabled={!currentAnswer.trim()}
                className="px-4 py-3 bg-purple-600 hover:bg-purple-700 dark:bg-purple-500 dark:hover:bg-purple-600 text-white rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
              >
                <Send className="w-4 h-4" />
                {currentQuestionIndex < questions.length - 1 ? 'Next' : 'Finish'}
              </button>
              <button
                type="button"
                onClick={handleSkipQuestion}
                className="px-4 py-2 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors flex items-center gap-1"
              >
                <SkipForward className="w-3 h-3" />
                Skip
              </button>
            </div>
          </div>
          <p className="mt-2 text-xs text-gray-500 dark:text-gray-400">
            Press Ctrl+Enter to submit
          </p>
        </form>
      </div>

      {/* Footer Actions */}
      <div className="p-4 bg-gray-50 dark:bg-gray-700/50 border-t border-gray-200 dark:border-gray-700 flex items-center justify-between">
        <p className="text-xs text-gray-500 dark:text-gray-400">
          You can skip questions or create with current information
        </p>
        <button
          type="button"
          onClick={() => {
            if (Object.keys(answers).length > 0) {
              onSubmit(answers);
            } else {
              onSkip();
            }
          }}
          className="text-sm text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 font-medium"
        >
          Create with Current Info →
        </button>
      </div>
    </div>
  );
}
