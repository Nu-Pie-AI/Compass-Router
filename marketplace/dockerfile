FROM node:20-alpine

WORKDIR /app

# Copy package files and prisma schema
COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies (this will run prisma generate via postinstall)
RUN npm install

# Copy the rest of the application
COPY . .

# Build the application (set dummy env vars for build time)
ENV OPENAI_API_KEY=sk-build-time-placeholder-key-not-for-actual-use
ENV DATABASE_URL=postgresql://user:pass@localhost:5432/build?schema=public
RUN npm run build
ENV OPENAI_API_KEY=
ENV DATABASE_URL=

EXPOSE 3000

ENV NODE_ENV=production

CMD ["npm", "start"]