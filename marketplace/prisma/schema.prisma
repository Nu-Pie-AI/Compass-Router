generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String?
  name              String?
  image             String?            @map("avatar")
  role              String             @default("user")
  emailVerified     DateTime?
  twoFactorEnabled  Boolean            @default(false)
  twoFactorMethod   TwoFactorMethod?
  totpSecretEncrypted String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  chatConversations ChatConversation[]
  offeringClicks    OfferingClick[]
  offeringViews     OfferingView[]
  partnerContacts   PartnerContact[]
  passwordResetTokens PasswordResetToken[]
  partner           Partner?
  productClicks     ProductClick[]
  productViews      ProductView[]
  reviewVotes       ReviewVote[]
  reviews           Review[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  twoFactorChallenges TwoFactorChallenge[]
  vendorContacts    VendorContact[]
  vendor            Vendor?

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  ext_expires_in    Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model TwoFactorChallenge {
  id        String    @id @default(cuid())
  codeHash  String
  method    TwoFactorMethod
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("two_factor_challenges")
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model Product {
  id                     String                    @id @default(cuid())
  slug                   String                    @unique
  name                   String
  description            String?
  shortDescription       String?                   @db.VarChar(500)
  logo                   String?
  videoUrl               String?
  website                String?
  averageRating          Float                     @default(0)
  reviewCount            Int                       @default(0)
  viewCount              Int                       @default(0)
  companyName            String?
  companySize            String?
  founded                String?
  headquarters           String?
  pricingModel           String?
  startingPrice          Float?
  hasFreeTrial           Boolean                   @default(false)
  freeTrialDays          Int?
  metaTitle              String?
  metaDescription        String?
  status                 String                    @default("draft")
  featured               Boolean                   @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  publishedAt            DateTime?
  vendorId               String?
  searchVector           Unsupported("tsvector")?  @map("search_vector")
  approvalStatus         String                    @default("not_submitted")
  approvedAt             DateTime?
  approvedBy             String?
  archivedAt             DateTime?
  archivedBy             String?
  currentVersion         Int                       @default(1)
  deletedAt              DateTime?
  deletedBy              String?
  revisionNotes          String?
  revisionRequested      Boolean                   @default(false)
  submittedForApprovalAt DateTime?
  listingType            ListingType               @default(SOFTWARE_PRODUCT)
  primaryFunction        String?
  smbFriendly            Boolean                   @default(true)
  externalRatings        ExternalRating[]
  features               Feature[]
  pricingPlans           PricingPlan[]
  productClicks          ProductClick[]
  onboardingAnswers      ProductOnboardingAnswer[]
  statusHistory          ProductStatusHistory[]
  versions               ProductVersion[]
  productViews           ProductView[]
  vendor                 Vendor?                   @relation(fields: [vendorId], references: [id])
  reviews                Review[]
  screenshots            Screenshot[]
  vendorContacts         VendorContact[]
  categories             Category[]                @relation("CategoryToProduct")

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([averageRating])
  @@index([vendorId])
  @@index([approvalStatus])
  @@index([name])
  @@map("products")
}

model ProductVersion {
  id          String   @id @default(cuid())
  version     Int
  name        String
  description String?
  changes     Json
  createdBy   String
  createdAt   DateTime @default(now())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_versions")
}

model ProductStatusHistory {
  id         String   @id @default(cuid())
  fromStatus String
  toStatus   String
  changedBy  String
  reason     String?
  createdAt  DateTime @default(now())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_status_history")
}

model Category {
  id           String     @id @default(cuid())
  slug         String     @unique
  name         String
  description  String?
  icon         String?
  parentId     String?
  productCount Int        @default(0)
  order        Int        @default(0)
  featured     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryHierarchy")
  offerings    Offering[] @relation("CategoryToOffering")
  products     Product[]  @relation("CategoryToProduct")

  @@index([slug])
  @@index([parentId])
  @@index([featured])
  @@map("categories")
}

model Screenshot {
  id         String    @id @default(cuid())
  url        String
  title      String?
  order      Int       @default(0)
  productId  String?
  createdAt  DateTime  @default(now())
  offeringId String?
  offering   Offering? @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([offeringId])
  @@map("screenshots")
}

model Feature {
  id          String    @id @default(cuid())
  name        String
  description String?
  category    String?
  order       Int       @default(0)
  productId   String?
  createdAt   DateTime  @default(now())
  offeringId  String?
  offering    Offering? @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([offeringId])
  @@map("features")
}

model PricingPlan {
  id           String    @id @default(cuid())
  name         String
  description  String?
  price        Float?
  billingCycle String?
  currency     String    @default("USD")
  features     String[]
  popular      Boolean   @default(false)
  order        Int       @default(0)
  productId    String?
  createdAt    DateTime  @default(now())
  offeringId   String?
  offering     Offering? @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  product      Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([offeringId])
  @@map("pricing_plans")
}

model Review {
  id                 String       @id @default(cuid())
  rating             Int
  title              String
  content            String
  pros               String?
  cons               String?
  userRole           String?
  companySize        String?
  industry           String?
  usageDuration      String?
  status             String       @default("pending")
  verified           Boolean      @default(false)
  verificationMethod String?
  helpfulCount       Int          @default(0)
  notHelpfulCount    Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  moderatedAt        DateTime?
  moderatedBy        String?
  moderationReason   String?
  userId             String
  productId          String?
  offeringId         String?
  votes              ReviewVote[]
  offering           Offering?    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  product            Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([offeringId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
  @@index([offeringId, status, createdAt])
  @@index([productId, status, createdAt])
  @@map("reviews")
}

model ReviewVote {
  id        String   @id @default(cuid())
  helpful   Boolean
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@map("review_votes")
}

model Vendor {
  id                    String                @id @default(cuid())
  companyName           String
  website               String?
  industry              String?
  companySize           String?
  description           String?
  logo                  String?
  contactEmail          String
  contactPhone          String?
  address               String?
  city                  String?
  country               String?
  status                String                @default("pending")
  onboardingComplete    Boolean               @default(false)
  verificationDocuments String[]
  totalProducts         Int                   @default(0)
  totalViews            Int                   @default(0)
  totalLeads            Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  approvedAt            DateTime?
  userId                String                @unique
  approvalNotes         String?
  approvedBy            String?
  canReapplyAt          DateTime?
  draftProducts         Int                   @default(0)
  lastActivityAt        DateTime              @default(now())
  pendingProducts       Int                   @default(0)
  publishedProducts     Int                   @default(0)
  rejectedAt            DateTime?
  rejectionReason       String?
  suspendedAt           DateTime?
  suspendedBy           String?
  suspensionReason      String?
  providerType          ProviderType          @default(SOFTWARE_VENDOR)
  products              Product[]
  contacts              VendorContact[]
  statusHistory         VendorStatusHistory[]
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("vendors")
}

model VendorStatusHistory {
  id         String   @id @default(cuid())
  fromStatus String
  toStatus   String
  changedBy  String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_status_history")
}

model VendorContact {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  status    String   @default("new")
  userId    String?
  productId String
  vendorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@map("vendor_contacts")
}

model SearchAnalytics {
  id           String   @id @default(cuid())
  query        String
  resultsCount Int
  userId       String?
  sessionId    String?
  createdAt    DateTime @default(now())

  @@index([query])
  @@index([createdAt])
  @@map("search_analytics")
}

model ProductView {
  id        String   @id @default(cuid())
  userId    String?
  productId String
  sessionId String?
  ipAddress String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@map("product_views")
}

model ChatConversation {
  id                      String                   @id @default(cuid())
  messages                Json
  context                 Json?
  userId                  String?
  sessionId               String?
  status                  String                   @default("active")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User?                    @relation(fields: [userId], references: [id])
  externalRecommendations ExternalRecommendation[]

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_conversations")
}

model ExternalRecommendation {
  id               String   @id @default(cuid())
  conversationId   String
  productName      String
  productUrl       String?
  category         String
  shortDescription String
  reasoning        String   @db.Text
  confidence       Float
  source           String   @default("ai_generated")
  clickCount       Int      @default(0)
  potentialLead    Boolean  @default(false)
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([category])
  @@index([createdAt])
  @@index([potentialLead])
  @@map("external_recommendations")
}

model ProductOnboardingQuestion {
  id             String                    @id @default(cuid())
  questionNumber Int
  subQuestionId  String?
  category       String
  questionText   String
  answerType     AnswerType
  options        Json?
  isRequired     Boolean                   @default(true)
  displayOrder   Int
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  answers        ProductOnboardingAnswer[]

  @@unique([questionNumber, subQuestionId])
  @@index([category])
  @@map("product_onboarding_questions")
}

model ProductOnboardingAnswer {
  id         String                    @id @default(cuid())
  productId  String
  questionId String
  answerText String?
  answerJson Json?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  product    Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  question   ProductOnboardingQuestion @relation(fields: [questionId], references: [id])

  @@unique([productId, questionId])
  @@index([productId])
  @@map("product_onboarding_answers")
}

model ProductClick {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  clickedAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  referrer  String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([sessionId])
  @@index([clickedAt])
  @@map("product_clicks")
}

model ExternalRating {
  id           String       @id @default(cuid())
  productId    String?
  offeringId   String?
  source       RatingSource
  rating       Float
  reviewCount  Int          @default(0)
  url          String?
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  offering     Offering?    @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, source])
  @@unique([offeringId, source])
  @@index([productId])
  @@index([offeringId])
  @@map("external_ratings")
}

model Partner {
  id                 String                 @id @default(cuid())
  companyName        String?
  providerType       ProviderType           @default(SOFTWARE_VENDOR)
  website            String?
  linkedInUrl        String?
  description        String?
  logo               String?
  industry           String?
  companySize        String?
  regions            String[]
  complianceFlags    String[]
  aiExtracted        Boolean                @default(false)
  scrapedAt          DateTime?
  scrapedContent     Json?
  overallConfidence  Float?
  onboardingStep     Int                    @default(1)
  // 👇 Approval Layer
  approvalStatus     ApprovalStatus         @default(PENDING)
  approvedAt         DateTime?
  rejectionReason    String?
  status             String                 @default("pending")
  verifiedAt         DateTime?
  approvedBy         String?
  suspendedAt        DateTime?
  suspensionReason   String?
  totalOfferings     Int                    @default(0)
  publishedOfferings Int                    @default(0)
  totalViews         Int                    @default(0)
  totalLeads         Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  userId             String                 @unique
  onboardedBy        String?
  onboardingMode     OnboardingMode?
  onboardingStatus   OnboardingStatus       @default(NOT_STARTED)
  offerings          Offering[]
  contacts           PartnerContact[]
  statusHistory      PartnerStatusHistory[]
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([providerType])
  @@index([onboardingStatus])
  @@map("partners")
}

model Offering {
  id                 String                     @id @default(cuid())
  slug               String                     @unique
  title              String
  shortDescription   String?                    @db.VarChar(500)
  description        String?
  logo               String?
  videoUrl           String?
  website            String?
  offeringType       OfferingType
  primaryFunction    String
  subCategory        String?
  useCases           String[]
  painPointsSolved   String[]
  integrations       String[]
  complianceFlags    String[]
  learningCurve      String?
  implementationTime String?
  icpTeamSize        String?
  icpIndustry        String[]
  icpCompanyStage    String?
  icpBudget          String?
  pricingModel       String?
  startingPrice      Float?
  hasFreeTrial       Boolean                    @default(false)
  freeTrialDays      Int?
  regions            String[]
  aiGenerated        Boolean                    @default(true)
  confidenceScore    Float?
  fieldConfidence    Json?
  humanReviewed      Boolean                    @default(false)
  reviewedAt         DateTime?
  reviewNotes        String?
  averageRating      Float                      @default(0)
  reviewCount        Int                        @default(0)
  viewCount          Int                        @default(0)
  status             String                     @default("draft")
  approvalStatus     String                     @default("not_submitted")
  featured           Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  publishedAt        DateTime?
  partnerId          String
  features           Feature[]
  offeringClicks     OfferingClick[]
  enrichmentAnswers  OfferingEnrichmentAnswer[]
  externalRatings    ExternalRating[]
  statusHistory      OfferingStatusHistory[]
  offeringViews      OfferingView[]
  partner            Partner                    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  contacts           PartnerContact[]
  pricingPlans       PricingPlan[]
  reviews            Review[]
  screenshots        Screenshot[]
  categories         Category[]                 @relation("CategoryToOffering")
  embedding          Float[]
  searchVector       Unsupported("tsvector")?   @map("search_vector")

  @@index([slug])
  @@index([status])
  @@index([partnerId])
  @@index([offeringType])
  @@index([primaryFunction])
  @@index([confidenceScore])
  @@index([searchVector], type: Gin)
  @@map("offerings")
}

model OfferingEnrichmentAnswer {
  id              String   @id @default(cuid())
  offeringId      String
  question        String
  answer          String
  aiGenerated     Boolean  @default(false)
  confidenceBoost Float?
  createdAt       DateTime @default(now())
  offering        Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@map("offering_enrichment_answers")
}

model OfferingView {
  id         String   @id @default(cuid())
  offeringId String
  userId     String?
  sessionId  String?
  ipAddress  String?
  userAgent  String?
  referrer   String?
  createdAt  DateTime @default(now())
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([offeringId])
  @@index([userId])
  @@index([createdAt])
  @@index([offeringId, createdAt])
  @@index([sessionId])
  @@map("offering_views")
}

model OfferingClick {
  id         String   @id @default(cuid())
  offeringId String
  userId     String?
  sessionId  String?
  clickType  String?
  clickedAt  DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  referrer   String?
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([offeringId])
  @@index([sessionId])
  @@index([clickedAt])
  @@index([offeringId, clickedAt])
  @@map("offering_clicks")
}

model OfferingStatusHistory {
  id         String   @id @default(cuid())
  fromStatus String
  toStatus   String
  changedBy  String
  reason     String?
  createdAt  DateTime @default(now())
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@map("offering_status_history")
}

model PartnerContact {
  id         String    @id @default(cuid())
  name       String
  email      String
  company    String?
  phone      String?
  message    String
  status     String    @default("new")
  userId     String?
  offeringId String?
  partnerId  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  offering   Offering? @relation(fields: [offeringId], references: [id])
  partner    Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id])

  @@index([offeringId])
  @@index([partnerId])
  @@index([status])
  @@index([partnerId, createdAt])
  @@index([offeringId, createdAt])
  @@map("partner_contacts")
}

model PartnerStatusHistory {
  id         String   @id @default(cuid())
  fromStatus String
  toStatus   String
  changedBy  String
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("partner_status_history")
}

enum ProviderType {
  SOFTWARE_VENDOR
  SERVICE_PROVIDER
  CONSULTING_FIRM
  SYSTEM_INTEGRATOR
  HYBRID
}

enum ListingType {
  SOFTWARE_PRODUCT
  PROFESSIONAL_SERVICE
  IMPLEMENTATION
  TRAINING
  MANAGED_SERVICE
}

enum AnswerType {
  TEXT
  MULTI_SELECT
  SINGLE_SELECT
  TEXT_WITH_SECTION
  MAIN_WITH_SUB
}

enum RatingSource {
  G2
  CAPTERRA
  TRUSTPILOT
  GOOGLE
  SOFTWARE_ADVICE
  GARTNER
}

enum OfferingType {
  PRODUCT
  SERVICE
  IMPLEMENTATION
  TRAINING
  MANAGED_SERVICE
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum OnboardingMode {
  SELF_INITIATED
  ADMIN_INITIATED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TwoFactorMethod {
  EMAIL
  TOTP
  BOTH
}
