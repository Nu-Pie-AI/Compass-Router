# Render with deployment-owned values before applying. No secret values belong here.
apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: ${WEB_SERVICE}
spec:
  template:
    spec:
      serviceAccountName: ${WEB_SERVICE_ACCOUNT}
      containers:
        - image: ${WEB_IMAGE}
          ports:
            - containerPort: 3000
          env:
            - name: NODE_ENV
              value: production
            - name: COMPASS_API_INTERNAL_URL
              value: ${API_INTERNAL_URL}
