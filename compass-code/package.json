{
  "name": "compass-code",
  "displayName": "Compass Router",
  "description": "A Compass Router coding agent for Visual Studio Code.",
  "version": "0.3.5",
  "publisher": "nu-pie",
  "icon": "media/compass-marketplace.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nu-Pie-AI/Compass.git",
    "directory": "compass-code"
  },
  "homepage": "https://github.com/Nu-Pie-AI/Compass/tree/main/compass-code",
  "bugs": {
    "url": "https://github.com/Nu-Pie-AI/Compass/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "compass",
    "coding assistant",
    "workspace agent"
  ],
  "activationEvents": [
    "onView:compassCode.chat",
    "onCommand:compassCode.connect",
    "onCommand:compassCode.disconnect",
    "onCommand:compassCode.openAgent",
    "onCommand:compassCode.newTask",
    "onCommand:compassCode.chooseModel",
    "onCommand:compassCode.chooseProject",
    "onCommand:compassCode.restoreCheckpoint",
    "onCommand:compassCode.openSettings",
    "onCommand:compassCode.openDashboard",
    "onCommand:compassCode.explainSelection",
    "onCommand:compassCode.fixSelection",
    "onCommand:compassCode.refactorSelection",
    "onCommand:compassCode.optimizeSelection",
    "onCommand:compassCode.generateTests",
    "onCommand:compassCode.generateDocumentation",
    "onCommand:compassCode.fixProblems",
    "onCommand:compassCode.reviewChanges",
    "onCommand:compassCode.generateCommitMessage",
    "onCommand:compassCode.stopAgent"
  ],
  "keybindings": [
    {
      "command": "compassCode.openAgent",
      "key": "ctrl+alt+shift+c"
    },
    {
      "command": "compassCode.newTask",
      "key": "ctrl+alt+shift+n",
      "when": "view == compassCode.chat"
    }
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "compassCode",
          "title": "Compass Router",
          "icon": "media/compass.svg"
        }
      ]
    },
    "views": {
      "compassCode": [
        {
          "type": "webview",
          "id": "compassCode.chat",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "compassCode.connect",
        "title": "Connect",
        "category": "Compass Router",
        "icon": "$(plug)"
      },
      {
        "command": "compassCode.disconnect",
        "title": "Disconnect",
        "category": "Compass Router",
        "icon": "$(sign-out)"
      },
      {
        "command": "compassCode.openAgent",
        "title": "AI: Open Assistant",
        "category": "Compass Router",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "compassCode.newTask",
        "title": "AI: New Chat",
        "category": "Compass Router",
        "icon": "$(add)"
      },
      {
        "command": "compassCode.chooseModel",
        "title": "Choose Model",
        "category": "Compass Router",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "compassCode.restoreCheckpoint",
        "title": "Restore Last Checkpoint",
        "category": "Compass Router",
        "icon": "$(history)"
      },
      {
        "command": "compassCode.openSettings",
        "title": "Compass Router Settings",
        "category": "Compass Router",
        "icon": "$(settings-gear)"
      },
      {
        "command": "compassCode.openHistory",
        "title": "Compass Router History",
        "category": "Compass Router",
        "icon": "$(history)"
      },
      {
        "command": "compassCode.openAccount",
        "title": "Compass Router Account",
        "category": "Compass Router",
        "icon": "$(account)"
      },
      {
        "command": "compassCode.openDashboard",
        "title": "Open Compass Dashboard",
        "category": "Compass Router",
        "icon": "$(link-external)"
      },
      {
        "command": "compassCode.explainSelection",
        "title": "AI: Explain Selection",
        "category": "Compass Router",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "compassCode.fixSelection",
        "title": "AI: Fix Selection",
        "category": "Compass Router",
        "icon": "$(wrench)"
      },
      {
        "command": "compassCode.refactorSelection",
        "title": "AI: Refactor Selection",
        "category": "Compass Router",
        "icon": "$(wand)"
      },
      {
        "command": "compassCode.optimizeSelection",
        "title": "AI: Optimize Selection",
        "category": "Compass Router",
        "icon": "$(rocket)"
      },
      {
        "command": "compassCode.generateTests",
        "title": "AI: Generate Tests",
        "category": "Compass Router",
        "icon": "$(beaker)"
      },
      {
        "command": "compassCode.generateDocumentation",
        "title": "AI: Generate Documentation",
        "category": "Compass Router",
        "icon": "$(book)"
      },
      {
        "command": "compassCode.fixProblems",
        "title": "AI: Fix Problems",
        "category": "Compass Router",
        "icon": "$(lightbulb)"
      },
      {
        "command": "compassCode.reviewChanges",
        "title": "AI: Review Changes",
        "category": "Compass Router",
        "icon": "$(git-compare)"
      },
      {
        "command": "compassCode.generateCommitMessage",
        "title": "AI: Generate Commit Message",
        "category": "Compass Router",
        "icon": "$(git-commit)"
      },
      {
        "command": "compassCode.stopAgent",
        "title": "AI: Stop Agent",
        "category": "Compass Router",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "compassCode.newTask",
          "when": "view == compassCode.chat",
          "group": "navigation@1"
        },
        {
          "command": "compassCode.chooseModel",
          "when": "view == compassCode.chat",
          "group": "navigation@2"
        },
        {
          "command": "compassCode.restoreCheckpoint",
          "when": "view == compassCode.chat",
          "group": "navigation@3"
        },
        {
          "command": "compassCode.openSettings",
          "when": "view == compassCode.chat",
          "group": "navigation@4"
        },
        {
          "command": "compassCode.openHistory",
          "when": "view == compassCode.chat",
          "group": "navigation@5"
        },
        {
          "command": "compassCode.openAccount",
          "when": "view == compassCode.chat",
          "group": "navigation@6"
        },
        {
          "command": "compassCode.openDashboard",
          "when": "view == compassCode.chat",
          "group": "navigation@7"
        },
        {
          "command": "compassCode.disconnect",
          "when": "view == compassCode.chat",
          "group": "navigation@8"
        }
      ],
      "editor/context": [
        {
          "command": "compassCode.explainSelection",
          "when": "editorHasSelection",
          "group": "inline@1"
        },
        {
          "command": "compassCode.fixSelection",
          "when": "editorHasSelection",
          "group": "inline@2"
        },
        {
          "command": "compassCode.refactorSelection",
          "when": "editorHasSelection",
          "group": "inline@3"
        },
        {
          "command": "compassCode.optimizeSelection",
          "when": "editorHasSelection",
          "group": "inline@4"
        },
        {
          "command": "compassCode.generateTests",
          "when": "editorHasSelection",
          "group": "inline@5"
        },
        {
          "command": "compassCode.generateDocumentation",
          "when": "editorHasSelection",
          "group": "inline@6"
        }
      ]
    },
    "configuration": {
      "title": "Compass Router",
      "properties": {
        "compassCode.provider": {
          "type": "string",
          "enum": [
            "compass",
            "openai-compatible",
            "ollama"
          ],
          "enumDescriptions": [
            "Compass Router API",
            "Any OpenAI-compatible API",
            "Local Ollama OpenAI-compatible API"
          ],
          "default": "compass",
          "description": "Model provider used by Compass Router."
        },
        "compassCode.apiBaseUrl": {
          "type": "string",
          "default": "https://compass-router-api-c4psf2dvua-uc.a.run.app",
          "description": "Compass API base URL. Do not include /v1."
        },
        "compassCode.projectId": {
          "type": "string",
          "default": "",
          "scope": "workspace",
          "description": "Authorized Compass project ID for this workspace. Leave empty to use the API key's assigned project."
        },
        "compassCode.marketplaceUrl": {
          "type": "string",
          "default": "https://compass.nu-pie.ai",
          "description": "Compass web console URL used by the dashboard command."
        },
        "compassCode.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Preferred model ID selected from the configured provider."
        },
        "compassCode.maxAgentSteps": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 24,
          "description": "Maximum model/tool iterations in one task."
        },
        "compassCode.requestTimeoutSeconds": {
          "type": "number",
          "default": 45,
          "minimum": 15,
          "maximum": 120,
          "description": "Maximum time to wait for one Compass response before showing a retryable error."
        },
        "compassCode.autoApproveReads": {
          "type": "boolean",
          "default": true,
          "description": "Allow workspace read, search, and diagnostics tools without prompting."
        },
        "compassCode.autoApproveWrites": {
          "type": "boolean",
          "default": false,
          "description": "Allow file writes without prompting. Checkpoints are still created."
        },
        "compassCode.autoApproveTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Allow terminal commands without prompting."
        },
        "compassCode.autoApproveNetwork": {
          "type": "boolean",
          "default": false,
          "description": "Allow network-enabled tools without prompting."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "tsc --noEmit",
    "test": "vitest run test",
    "test:ui": "npm run build && playwright test",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run check && npm run test && npm run build",
    "package": "npx vsce package --no-dependencies"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.4.2",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
