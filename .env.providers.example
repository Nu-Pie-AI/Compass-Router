# Local provider credential file for Compass.
# Copy this file to .env.providers and replace only the values you use.
# Never commit .env.providers or paste these values into the frontend/extension.
# The API encrypts these values locally, or writes them to Secret Manager when
# SECRET_MANAGER_ENABLED=true. A key only registers the provider credential;
# activate/discover the provider's models from the admin console.

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
DEEPINFRA_API_KEY=
HUGGINGFACE_API_KEY=

# Azure and Google Cloud entries may require endpoint/project/deployment
# settings in addition to a key. Bedrock uses AWS IAM, not one API key.
AZURE_OPENAI_API_KEY=
AZURE_AI_API_KEY=
VERTEX_AI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
