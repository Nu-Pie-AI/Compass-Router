# Copy this file to .env.local and replace the placeholder with the Clerk
# publishable key for the Clerk application used by Compass Router.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Compass API reachable from the browser during local development.
NEXT_PUBLIC_COMPASS_API_URL=http://localhost:28000

# Optional marketplace URL used by the web application.
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3100
