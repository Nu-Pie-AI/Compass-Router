ENVIRONMENT=development
APP_SECRET=replace-with-strong-random-secret
POSTGRES_USER=compass
POSTGRES_PASSWORD=compass
POSTGRES_DB=compass
POSTGRES_PORT=25432
DATABASE_URL=postgresql+psycopg://compass:compass@postgres:5432/compass
TEST_DATABASE_URL=sqlite:///./test_compass.db
REDIS_URL=redis://redis:6379/0
REDIS_PORT=26379
COMPASS_WEB_ORIGIN=http://localhost:23000,http://localhost:23100
COMPASS_SSO_SECRET=replace-with-a-random-shared-secret
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3100
COMPASS_API_PORT=28000
COMPASS_WEB_PORT=23000
LITELLM_PORT=24000
COMPASS_LITELLM_IMAGE=compass-litellm:1.99.0-compass.1
COMPASS_LITELLM_URL=http://litellm:4000
COMPASS_LITELLM_OPENAI_API_KEY=replace-with-openai-key-only-for-real-provider-smoke
COMPASS_LITELLM_OLLAMA_API_KEY=replace-with-ollama-cloud-key-only-for-direct-litellm-smoke
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=local-dev-litellm-key
LITELLM_TIMEOUT_SECONDS=60
LITELLM_CATALOG_CACHE_SECONDS=300
# Configurable billing conversion for LiteLLM USD token prices. 8500 paise = INR 85 per USD.
USD_TO_INR_PAISE_PER_USD=8500
BILLING_PAYMENT_MODE=development
LOCAL_TEST_MODE=true
# Local Compose only. Keep false in environments where accounts are operator-provisioned.
PUBLIC_SIGNUP_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CompassAdmin123!
ADMIN_NAME=Compass Operator
# Local development customer fixture only. Change or disable local test mode outside local development.
LOCAL_TEST_CUSTOMER_EMAIL=customer@example.com
LOCAL_TEST_CUSTOMER_PASSWORD=CompassCustomer123!
LOCAL_TEST_CUSTOMER_NAME=Compass Customer
LOCAL_TEST_CUSTOMER_TEAM_NAME=Customer Demo Team
LOCAL_TEST_CUSTOMER_TEAM_SLUG=customer-demo
LOCAL_TEST_CUSTOMER_2_EMAIL=customer2@example.com
LOCAL_TEST_CUSTOMER_2_PASSWORD=CompassCustomer456!
LOCAL_TEST_CUSTOMER_2_NAME=Compass Customer Two
LOCAL_TEST_CUSTOMER_2_TEAM_NAME=Customer Two Demo Team
LOCAL_TEST_CUSTOMER_2_TEAM_SLUG=customer-two-demo
DEFAULT_TEAM_REQUEST_LIMIT_PER_MINUTE=60
DEFAULT_TEAM_TOKEN_LIMIT_PER_MINUTE=250000
DEFAULT_TEAM_DAILY_SPEND_LIMIT_PAISE=100000
DEFAULT_TEAM_MONTHLY_SPEND_LIMIT_PAISE=1000000
NEXT_PUBLIC_COMPASS_API_URL=http://localhost:28000
COMPASS_API_INTERNAL_URL=http://compass-api:8000
REQUEST_BODY_LIMIT_BYTES=1000000
LOCAL_TEST_INPUT_PRICE_PAISE_PER_1K=2
LOCAL_TEST_OUTPUT_PRICE_PAISE_PER_1K=6
LOCAL_TEST_WALLET_CREDIT_PAISE=50000
OPENAI_API_KEY=replace-with-openai-key-for-real-litellm-only
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
GCP_PROJECT_ID=replace-with-gcp-project
GCP_SECRET_MANAGER_PREFIX=compass
SECRET_MANAGER_ENABLED=false
SENTRY_DSN=
# COMPASS_API_KEY=generate-in-the-local-ui-and-do-not-commit
