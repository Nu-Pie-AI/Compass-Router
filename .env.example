ENVIRONMENT=development
APP_SECRET=replace-with-strong-random-secret
POSTGRES_USER=compass
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_MIGRATION_MODE=legacy
POSTGRES_DB=compass
POSTGRES_PORT=25432
#DATABASE_URL=postgresql+psycopg://compass:compass@postgres:5432/compass
#TEST_DATABASE_URL=sqlite:///./test_compass.db
REDIS_URL=redis://redis:6379/0
REDIS_PORT=26379
REDIS_SOCKET_TIMEOUT_SECONDS=1.5
REDIS_CONNECT_TIMEOUT_SECONDS=3.0
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ATTEMPTS=2
COMPASS_WEB_ORIGIN=http://localhost:23000,http://localhost:23100
COMPASS_SSO_SECRET=replace-with-a-random-shared-secret
DIRECT_DATABASE_URL=postgresql+psycopg://replace-with-neon-direct-user:replace-with-neon-direct-password@replace-with-neon-staging-direct-host/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://replace-with-neon-pooled-user:replace-with-neon-pooled-password@replace-with-neon-staging-pooler-host/neondb?sslmode=require
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:23000
CLERK_AUDIENCE=
CLERK_WEBHOOK_SIGNING_SECRET=replace-with-clerk-webhook-signing-secret
CLERK_ORGANIZATION_INVITATIONS_ENABLED=false
CLERK_INVITATION_REDIRECT_URL=/portal
NEXT_PUBLIC_MARKETPLACE_URL=http://localhost:3100
COMPASS_API_PORT=28000
COMPASS_WEB_PORT=23000
LITELLM_PORT=24000
COMPASS_LITELLM_IMAGE=compass-litellm:1.99.0-compass.1
COMPASS_LITELLM_URL=http://litellm:4000
COMPASS_LITELLM_OPENAI_API_KEY=replace-with-openai-key-only-for-real-provider-smoke
COMPASS_LITELLM_OLLAMA_API_KEY=replace-with-ollama-cloud-key-only-for-direct-litellm-smoke
LITELLM_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace-with-local-litellm-key
LITELLM_TIMEOUT_SECONDS=60
PROVIDER_EXECUTION_MODE=proxy
PROVIDER_MAX_ATTEMPTS=2
# missing = admin-panel credentials win; replace = this file wins on startup.
PROVIDER_ENV_SYNC_MODE=missing
LITELLM_CATALOG_CACHE_SECONDS=300
# Configurable billing conversion for LiteLLM USD token prices. 8500 paise = INR 85 per USD.
USD_TO_INR_PAISE_PER_USD=8500
# Optional provider route. OpenRouter is not required for Router startup or routing.
OPENROUTER_API_KEY=replace-with-optional-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_CATALOG_CACHE_SECONDS=300
OPENROUTER_CATALOG_STALE_AFTER_SECONDS=3600
OPENROUTER_CATALOG_SYNC_MAX_ATTEMPTS=3
OPENROUTER_CATALOG_BACKOFF_SECONDS=0.5
MODEL_PRICING_MARKUP_BPS=0
PRICING_FX_SOURCE=fixed_local
PRICING_FX_REFRESH_SECONDS=600
PRICING_FX_MAX_AGE_SECONDS=1800
PRICING_FX_BUFFER_BPS=500
PRICING_PLATFORM_FEE_BPS=500
PRICING_ALLOW_FIXED_FX_FALLBACK=true
PRICING_LOW_CREDITS_THRESHOLD_PAISE=1000
PRICING_VERIFICATION_MAX_AGE_SECONDS=86400
BILLING_PAYMENT_MODE=development
EMAIL_DELIVERY_MODE=outbox
EMAIL_FROM=no-reply@compass-router.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_MAX_ATTEMPTS=5
LOCAL_TEST_MODE=false
# Local Compose only. Keep false in environments where accounts are operator-provisioned.
PUBLIC_SIGNUP_ENABLED=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-local-admin-password
ADMIN_NAME=Compass Operator
PLATFORM_SUPER_ADMIN_CLERK_USER_ID=
PLATFORM_SUPER_ADMIN_REQUIRE_MFA=true
ADMIN_FINANCIAL_CONFIRMATION_THRESHOLD_PAISE=100000
# Local development customer fixture only. Change or disable local test mode outside local development.
LOCAL_TEST_CUSTOMER_EMAIL=customer@example.com
LOCAL_TEST_CUSTOMER_PASSWORD=replace-with-local-customer-password
LOCAL_TEST_CUSTOMER_NAME=Compass Customer
LOCAL_TEST_CUSTOMER_TEAM_NAME=Customer Demo Team
LOCAL_TEST_CUSTOMER_TEAM_SLUG=customer-demo
LOCAL_TEST_CUSTOMER_2_EMAIL=customer2@example.com
LOCAL_TEST_CUSTOMER_2_PASSWORD=replace-with-second-local-customer-password
LOCAL_TEST_CUSTOMER_2_NAME=Compass Customer Two
LOCAL_TEST_CUSTOMER_2_TEAM_NAME=Customer Two Demo Team
LOCAL_TEST_CUSTOMER_2_TEAM_SLUG=customer-two-demo
DEFAULT_TEAM_REQUEST_LIMIT_PER_MINUTE=60
DEFAULT_TEAM_TOKEN_LIMIT_PER_MINUTE=250000
DEFAULT_TEAM_DAILY_SPEND_LIMIT_PAISE=100000
DEFAULT_TEAM_MONTHLY_SPEND_LIMIT_PAISE=1000000
NEXT_PUBLIC_COMPASS_API_URL=http://localhost:28000
COMPASS_API_INTERNAL_URL=http://compass-api:8000
REQUEST_BODY_LIMIT_BYTES=1000000
LOCAL_TEST_INPUT_PRICE_PAISE_PER_1K=2
LOCAL_TEST_OUTPUT_PRICE_PAISE_PER_1K=6
LOCAL_TEST_WALLET_CREDIT_PAISE=50000
OPENAI_API_KEY=replace-with-openai-key-for-real-litellm-only
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
GCP_PROJECT_ID=replace-with-gcp-project
GCP_SECRET_MANAGER_PREFIX=compass
SECRET_MANAGER_ENABLED=false
SENTRY_DSN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
# COMPASS_API_KEY=generate-in-the-local-ui-and-do-not-commit
